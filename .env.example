# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Supabase Configuration (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional Configuration
OWNER_ID=your_discord_user_id
CO_OWNERS=

# Economy Settings
BONUS_PERCENT=10
MAX_BALANCE=100000000
TRANSFER_TAX_PERCENT=10

# ── Website Backend (backend/ FastAPI service) ─────────────────
# Зөвхөн backend service-д хэрэгтэй (SUPABASE_URL/KEY-г дээрээс хуваалцана)
# ALLOWED_ORIGINS=https://your-domain.web.app,https://custom-domain.com
# HEARTBEAT_FRESH_SECS=120
# STATUS_CACHE_TTL=20
# LIST_CACHE_TTL=60
# PORT=8080