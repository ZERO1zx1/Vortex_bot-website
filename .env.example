# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Supabase Configuration (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret key (preferred). Never place this in website/js or commit it.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Legacy alternatives are accepted during migration:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here
# SUPABASE_KEY=your_existing_server_key_here

# Optional Configuration
OWNER_ID=your_discord_user_id
CO_OWNERS=
GUILD_ID=your_discord_server_id

# Economy Settings
BONUS_PERCENT=10
MAX_BALANCE=100000000
TRANSFER_TAX_PERCENT=10
