"""Find branding typo in test_fonts.py."""
WRONG = chr(0x1D4F0)  # Mathematical Bold Script Small G
CORRECT = chr(0x1D4F1)  # Mathematical Bold Script Small H

filepath = "tests/test_fonts.py"
with open(filepath, "r", encoding="utf-8") as f:
    lines = f.readlines()

found = False
for i, line in enumerate(lines, 1):
    if WRONG in line:
        found = True
        print(f"Line {i}: {line.rstrip()}")
        # Show context
        for j, c in enumerate(line):
            if c == WRONG:
                print(f"  Wrong char at pos {j}: U+{ord(c):04X}")

if not found:
    print("No wrong char found in test_fonts.py")
    # Check if canonical is present
    if CORRECT in lines[256]:
        print(f"Line 257 already has correct char: {lines[256].rstrip()}")
